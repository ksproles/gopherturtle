rules_version = '2';

// Memo audio lives at audio/{authorUid}/{memoId}. Listening follows the same
// rules as reading the memo in Firestore.
service firebase.storage {
  match /b/{bucket}/o {
    function memoData(memoId) {
      return firestore.get(/databases/(default)/documents/memos/$(memoId)).data;
    }
    function canHear(m, author) {
      return m.audience == 'global'
        || (m.audience == 'followers'
            && firestore.exists(/databases/(default)/documents/follows/$(request.auth.uid + '_' + author)))
        || (m.audience == 'close'
            && request.auth.uid in firestore.get(/databases/(default)/documents/users/$(author)/private/closeFriends).data.uids);
    }

    // Profile photos: anyone signed in can see them; only you can change yours.
    match /avatars/{uid}/{file} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /audio/{uid}/{memoId} {
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
      // Same rule as hearing the memo in Firestore (see canHear in firestore.rules).
      allow read: if request.auth != null && (
        request.auth.uid == uid || canHear(memoData(memoId), uid));
    }
  }
}
