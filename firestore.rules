rules_version = '2';

// Who can read and write what in Gopher Turtle.
// The data model is described at the top of www/backend-firebase.js.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function validHandle(h) { return h is string && h.matches('^[a-z0-9_]{3,20}$'); }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 40; }
    // Up to 3 tags on a memo, each 1–24 characters. Optional, so older app versions still work.
    function validTag(t) { return t is string && t.size() > 0 && t.size() <= 24; }
    function validTags(d) {
      return !('tags' in d) || (d.tags is list && d.tags.size() <= 3
        && (d.tags.size() < 1 || validTag(d.tags[0]))
        && (d.tags.size() < 2 || validTag(d.tags[1]))
        && (d.tags.size() < 3 || validTag(d.tags[2])));
    }
    function validBio(b) { return b is string && b.size() <= 120; }
    function validLink(l) { return l == '' || (l is string && l.size() <= 200 && l.matches('^https?://[^ ]+$')); }
    function validPhoto(p) {
      return p == '' || (p is string && p.size() <= 1000
        && p.matches('^(https://firebasestorage[.]googleapis[.]com/|http://(127[.]0[.]0[.]1|localhost):9199/).*'));
    }
    // Who can hear a memo: its author; everyone for global; approved followers
    // for followers-only; people on the author's close friends list for close.
    // Access follows the current relationship, so it ends when a follow is
    // removed or someone is taken off the list.
    function canHear(m) {
      return m.authorId == me()
        || m.audience == 'global'
        || (m.audience == 'followers' && exists(/databases/$(database)/documents/follows/$(me() + '_' + m.authorId)))
        || (m.audience == 'close' && me() in get(/databases/$(database)/documents/users/$(m.authorId)/private/closeFriends).data.uids);
    }
    // True when `owner` has blocked the signed-in user.
    function blockedBy(owner) { return exists(/databases/$(database)/documents/users/$(owner)/blocked/$(me())); }

    // Public profiles.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'nameLower', 'handle', 'color', 'createdAt'])
        && validName(request.resource.data.name)
        && request.resource.data.nameLower == request.resource.data.name.lower()
        && validHandle(request.resource.data.handle)
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.uid == uid
        && request.resource.data.createdAt == request.time;
      // You can change your name, bio (120 max), link (a web address) and photo
      // (only an image stored in this app's own storage). Not your handle.
      allow update: if signedIn() && me() == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nameLower', 'color', 'bio', 'link', 'photoURL'])
        && validName(request.resource.data.name)
        && request.resource.data.nameLower == request.resource.data.name.lower()
        && validBio(request.resource.data.get('bio', ''))
        && validLink(request.resource.data.get('link', ''))
        && validPhoto(request.resource.data.get('photoURL', ''));
      allow delete: if signedIn() && me() == uid;

      // Private data such as the close friends list: only the owner, ever.
      match /private/{docId} {
        allow read, write: if signedIn() && me() == uid;
      }

      // People you've blocked. Only you can see or change this list.
      match /blocked/{otherUid} {
        allow read, delete: if signedIn() && me() == uid;
        allow create: if signedIn() && me() == uid && otherUid != uid
          && request.resource.data.keys().hasOnly(['createdAt']);
      }
    }

    // Handle reservations keep @handles unique.
    match /handles/{handle} {
      allow get: if true;
      allow create: if signedIn() && validHandle(handle)
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me()
        && getAfter(/databases/$(database)/documents/users/$(me())).data.handle == handle;
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Follow requests: requester_target. The requester can cancel; the person
    // being followed approves (turning it into a follow) or declines.
    match /followRequests/{id} {
      allow read: if signedIn() && (resource.data.requester == me() || resource.data.target == me());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['requester', 'target', 'createdAt'])
        && request.resource.data.requester == me()
        && request.resource.data.target != me()
        && id == me() + '_' + request.resource.data.target
        && exists(/databases/$(database)/documents/users/$(request.resource.data.target))
        && !exists(/databases/$(database)/documents/follows/$(me() + '_' + request.resource.data.target))
        && !blockedBy(request.resource.data.target)
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && (resource.data.requester == me() || resource.data.target == me());
    }

    // follower_target. Only the person being followed can create one, by
    // approving a pending request (and removing it in the same write).
    // You can unfollow, or remove one of your followers.
    match /follows/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['follower', 'target', 'createdAt'])
        && request.resource.data.target == me()
        && request.resource.data.follower != me()
        && id == request.resource.data.follower + '_' + me()
        && exists(/databases/$(database)/documents/followRequests/$(id))
        && !existsAfter(/databases/$(database)/documents/followRequests/$(id));
      allow delete: if signedIn() && (resource.data.follower == me() || resource.data.target == me());
    }

    match /memos/{memoId} {
      function canRead() { return canHear(resource.data); }
      function likePath() { return /databases/$(database)/documents/memos/$(memoId)/likes/$(me()); }
      function ampPath() { return /databases/$(database)/documents/amplifies/$(me() + '_' + memoId); }
      function ampCount(data) { return data.get('amplifyCount', 0); }

      allow read: if signedIn() && canRead();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['authorId', 'audience', 'createdAt', 'duration', 'caption', 'peaks', 'audioPath', 'likeCount', 'tags'])
        && validTags(request.resource.data)
        && request.resource.data.authorId == me()
        && request.resource.data.audience in ['close', 'followers', 'global']
        && request.resource.data.createdAt == request.time
        && request.resource.data.duration is number && request.resource.data.duration > 0 && request.resource.data.duration <= 305
        && request.resource.data.caption is string && request.resource.data.caption.size() <= 120
        && request.resource.data.peaks is list && request.resource.data.peaks.size() <= 64
        && request.resource.data.audioPath == 'audio/' + me() + '/' + memoId
        && request.resource.data.likeCount == 0;
      // The only changes anyone can make: a like/unlike paired with their like doc,
      // or an amplify/unamplify of a public memo paired with their amplify doc.
      allow update: if signedIn() && canRead() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
          && ((request.resource.data.likeCount == resource.data.likeCount + 1
                && !exists(likePath()) && existsAfter(likePath()))
            || (request.resource.data.likeCount == resource.data.likeCount - 1
                && exists(likePath()) && !existsAfter(likePath()))))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amplifyCount'])
          && resource.data.audience == 'global'
          && ((ampCount(request.resource.data) == ampCount(resource.data) + 1
                && !exists(ampPath()) && existsAfter(ampPath()))
            || (ampCount(request.resource.data) == ampCount(resource.data) - 1
                && exists(ampPath()) && !existsAfter(ampPath())))));
      allow delete: if signedIn() && resource.data.authorId == me();

      // Text comments. Anyone who can hear the memo can comment, unless the
      // memo's author has blocked them. Comment authors and memo authors can delete.
      match /comments/{commentId} {
        function memo() { return get(/databases/$(database)/documents/memos/$(memoId)).data; }
        function canReadMemo() { return canHear(memo()); }
        allow read: if signedIn() && canReadMemo();
        allow create: if signedIn() && canReadMemo()
          && !blockedBy(memo().authorId)
          && request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt'])
          && request.resource.data.authorId == me()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 280
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && (resource.data.authorId == me() || memo().authorId == me());
      }

      match /likes/{uid} {
        allow get: if signedIn() && uid == me();
        allow create: if signedIn() && uid == me()
          && request.resource.data.keys().hasOnly(['createdAt'])
          && getAfter(/databases/$(database)/documents/memos/$(memoId)).data.likeCount == get(/databases/$(database)/documents/memos/$(memoId)).data.likeCount + 1;
        allow delete: if signedIn() && uid == me()
          && getAfter(/databases/$(database)/documents/memos/$(memoId)).data.likeCount == get(/databases/$(database)/documents/memos/$(memoId)).data.likeCount - 1;
      }
    }

    // Lets you find your own comments across all memos (used when deleting your account).
    match /{path=**}/comments/{commentId} {
      allow read: if signedIn() && resource.data.authorId == me();
    }

    // Amplifies (reposts) of public memos: {uid}_{memoId}. Visible to everyone
    // signed in, so followers see what you amplified. Each one is paired with
    // the memo's amplifyCount going up or down by exactly one.
    match /amplifies/{id} {
      function memoPath(memoId) { return /databases/$(database)/documents/memos/$(memoId); }
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'memoId', 'authorId', 'createdAt'])
        && request.resource.data.uid == me()
        && id == me() + '_' + request.resource.data.memoId
        && get(memoPath(request.resource.data.memoId)).data.audience == 'global'
        && get(memoPath(request.resource.data.memoId)).data.authorId == request.resource.data.authorId
        && request.resource.data.authorId != me()
        && !blockedBy(request.resource.data.authorId)
        && request.resource.data.createdAt == request.time
        && getAfter(memoPath(request.resource.data.memoId)).data.get('amplifyCount', 0)
            == get(memoPath(request.resource.data.memoId)).data.get('amplifyCount', 0) + 1;
      allow delete: if signedIn() && resource.data.uid == me()
        && (!exists(memoPath(resource.data.memoId))
          || getAfter(memoPath(resource.data.memoId)).data.get('amplifyCount', 0)
            == get(memoPath(resource.data.memoId)).data.get('amplifyCount', 0) - 1);
    }

    // Reports of memos, comments or people. Anyone signed in can file one;
    // nobody can read them from the app. Review them in the Firebase console.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['reporterId', 'type', 'targetId', 'targetAuthorId', 'memoId', 'reason', 'text', 'status', 'createdAt'])
        && request.resource.data.reporterId == me()
        && request.resource.data.type in ['memo', 'comment', 'user']
        && request.resource.data.targetId is string
        && request.resource.data.targetAuthorId is string
        && request.resource.data.reason in ['spam', 'harassment', 'hate', 'sexual', 'violence', 'self-harm', 'other']
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
    }

    // Each person's inbox of followers-only and close friends memos (used to build
    // Home; it doesn't grant access by itself, canHear does).
    // An author can deliver a memo only to their followers (followers-only)
    // or to people on their own private close friends list (close friends).
    match /feeds/{owner}/items/{memoId} {
      allow read: if signedIn() && me() == owner;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['authorId', 'audience', 'createdAt'])
        && request.resource.data.authorId == me()
        && get(/databases/$(database)/documents/memos/$(memoId)).data.authorId == me()
        && get(/databases/$(database)/documents/memos/$(memoId)).data.audience == request.resource.data.audience
        && ((request.resource.data.audience == 'followers'
              && exists(/databases/$(database)/documents/follows/$(owner + '_' + me())))
          || (request.resource.data.audience == 'close'
              && owner in get(/databases/$(database)/documents/users/$(me())/private/closeFriends).data.uids))
        && !blockedBy(owner);
      allow delete: if signedIn() && (me() == owner || resource.data.authorId == me());
    }
  }
}
