{
  "name": "gopherturtle",
  "version": "1.0.0",
  "private": true,
  "description": "Gopher Turtle \u2014 scrollable voice memos",
  "scripts": {
    "serve": "python3 -m http.server 8000 --directory www",
    "sync": "cap sync",
    "ios": "cap open ios",
    "android": "cap open android",
    "build:firebase": "esbuild src/firebase-sdk.js --bundle --format=esm --minify --target=es2020 --outfile=www/vendor/firebase.js",
    "emulators": "firebase emulators:start --project demo-gopherturtle --only auth,firestore,storage,hosting",
    "test:rules": "firebase emulators:exec --project demo-gopherturtle --only auth,firestore,storage \"node test/rules.test.mjs\""
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.32.1"
  }
}
